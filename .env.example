# Variables de entorno para Supabase
# Copia este archivo como .env.local y reemplaza los valores

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Google Analytics 4. Vacío = no se carga el script ni el banner.
# En producción vive en `.env.production` (se incrusta al hacer `npm run build`).
VITE_GA_MEASUREMENT_ID=G-SNFN9CZVGV

# Solo para scripts locales (backfill-slugs). No commitear. Dashboard > Settings > API
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
