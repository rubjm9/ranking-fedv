{
  "redirects": [
    {
      "source": "/tournaments",
      "destination": "/campeonatos",
      "permanent": true
    },
    {
      "source": "/tournaments/:id",
      "destination": "/campeonatos/:id",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
